# Postgres
POSTGRES_USER=gc
POSTGRES_PASSWORD=gc_dev_password
POSTGRES_DB=greeting_cards
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO / S3-compatible object store
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=greeting-cards
MINIO_BUCKET_RAW=greeting-cards-raw

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Scraping
SCRAPER_USER_AGENT="greeting-cards-research/0.1 (+mailto:gagan708344@gmail.com)"
SCRAPER_RATE_LIMIT_PER_SEC=1.0
SCRAPER_CACHE_DIR=./.cache/raw_html
SCRAPER_RAW_HTML_TTL_DAYS=30

# LLM APIs (used for brief + inside message generation)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# HuggingFace (for gated models like Flux)
HF_TOKEN=

# Diffusion
DIFFUSION_BACKEND=sdxl
SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
SDXL_REVISION=
FLUX_MODEL_ID=black-forest-labs/FLUX.1-dev
FLUX_FILL_MODEL_ID=black-forest-labs/FLUX.1-Fill-dev

# Weights & Biases
WANDB_API_KEY=
WANDB_PROJECT=greeting-cards
WANDB_ENTITY=

# Prolific
PROLIFIC_API_TOKEN=

# Google Forms / Sheets (survey instrument)
# 1. Create a Google Cloud project, enable Forms API + Sheets API + Drive API.
# 2. Create a service account, download the JSON key, set the path below.
# 3. Run: python -m survey.instrument.forms_creator
#    It will create the form, print the form URL, and output all ENTRY_* values.
# 4. Paste the printed values here.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google_service_account.json
GOOGLE_FORMS_ID=
GOOGLE_SHEETS_ID=
GOOGLE_FORM_ENTRY_PARTICIPANT_ID=
GOOGLE_FORM_ENTRY_CARD_KEY=
GOOGLE_FORM_ENTRY_OCCASION=
GOOGLE_FORM_ENTRY_STUDY_ID=
GOOGLE_FORM_ENTRY_PURCHASE_INTENT=
GOOGLE_FORM_ENTRY_OCCASION_FIT=
GOOGLE_FORM_ENTRY_AESTHETIC=
GOOGLE_FORM_ENTRY_EMOTIONAL_RESONANCE=
GOOGLE_FORM_ENTRY_DISTINCTIVENESS=
GOOGLE_FORM_ENTRY_MAX_PRICE_GBP=
GOOGLE_FORM_ENTRY_FREE_TEXT=

# Misc
LOG_LEVEL=INFO
RANDOM_SEED=42
