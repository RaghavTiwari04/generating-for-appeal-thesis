# Cluster .env — copy to project root: cp cluster/.env.cluster .env
# Then fill in API keys below (never commit .env!)

# Postgres — running locally on compute node (see import_cluster.sh)
POSTGRES_USER=gc
POSTGRES_PASSWORD=gc_dev_password
POSTGRES_DB=greeting_cards
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# MinIO — running locally (see import_cluster.sh)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=greeting-cards
MINIO_BUCKET_RAW=greeting-cards-raw

# Redis (not needed on cluster unless running web app)
REDIS_HOST=localhost
REDIS_PORT=6379

# ── API Keys (ADD MANUALLY — never commit!) ─────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
WANDB_API_KEY=

# LLM
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Diffusion — use flux on A40/A100, sdxl on A16/T4
DIFFUSION_BACKEND=flux
SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
FLUX_MODEL_ID=black-forest-labs/FLUX.1-dev
FLUX_FILL_MODEL_ID=black-forest-labs/FLUX.1-Fill-dev

# W&B
WANDB_PROJECT=greeting-cards
WANDB_ENTITY=

# Prolific (not needed on cluster)
PROLIFIC_API_TOKEN=

# Misc
LOG_LEVEL=INFO
RANDOM_SEED=42
